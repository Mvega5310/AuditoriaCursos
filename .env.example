# Copiar este archivo como .env y completar los valores reales
# NUNCA subir el archivo .env a un repositorio

# Cuenta Gmail que envia los correos (puede ser una dedicada al sistema)
GMAIL_USER=correo_remitente@gmail.com

# Contrasena de aplicacion de Gmail (NO es la contrasena normal de Gmail)
# Crear en: Cuenta de Google > Seguridad > Verificacion en 2 pasos > Contrasenas de aplicaciones
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Envio por Resend (OBLIGATORIO en Railway: bloquea el SMTP). Dominio verificado en https://resend.com/domains
RESEND_API_KEY=
EMAIL_FROM=autCursos <alertas@sudominio.com>

# Correo de respaldo: recibe la alerta de una empresa que NO tiene responsables registrados
# (los responsables de cada empresa se cargan en la hoja "Empresas" del Excel)
RRHH_EMAIL=rrhh@empresa.com

# Opcional: recibe copia oculta de las alertas de TODAS las empresas (administrador del sistema)
ADMIN_EMAIL=

# ---- Aplicacion web (produccion en Railway) ----
# Cadena aleatoria larga (firma sesiones y enlaces de verificacion). Generar: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# URL publica de la app, sin barra final (se usa en el enlace de verificacion del correo)
APP_URL=http://localhost:8000
# 1 en produccion (HTTPS)
COOKIE_SECURE=0
# 1 = la app ejecuta las alertas programadas (dejar en 1 en Railway)
RUN_SCHEDULER=0
# Postgres: en Railway se referencia con ${{Postgres.DATABASE_URL}}. Vacio = SQLite local (db/cursos.db)
DATABASE_URL=
