# Copiar este archivo como .env y completar los valores reales
# NUNCA subir el archivo .env a un repositorio

# Cuenta Gmail que envia los correos (puede ser una dedicada al sistema)
GMAIL_USER=correo_remitente@gmail.com

# Contrasena de aplicacion de Gmail (NO es la contrasena normal de Gmail)
# Crear en: Cuenta de Google > Seguridad > Verificacion en 2 pasos > Contrasenas de aplicaciones
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Correo de respaldo: recibe la alerta de una empresa que NO tiene responsables registrados
# (los responsables de cada empresa se cargan en la hoja "Empresas" del Excel)
RRHH_EMAIL=rrhh@empresa.com

# Opcional: recibe copia oculta de las alertas de TODAS las empresas (administrador del sistema)
ADMIN_EMAIL=
