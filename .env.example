# Copiar este archivo como .env y completar los valores reales
# NUNCA subir el archivo .env a un repositorio

# Cuenta Gmail que envia los correos (puede ser la misma de RRHH o una dedicada)
GMAIL_USER=correo_remitente@gmail.com

# Contrasena de aplicacion de Gmail (NO es la contrasena normal de Gmail)
# Crear en: Cuenta de Google > Seguridad > Verificacion en 2 pasos > Contrasenas de aplicaciones
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Correo de RRHH que recibe todas las alertas
RRHH_EMAIL=rrhh@empresa.com
