# Secretos y configuracion local
.env

# Python
__pycache__/
*.pyc
.pytest_cache/

# Base de datos y logs (datos generados, no codigo)
db/*.db
db/*.db.bak-*
logs/*.log

# Salidas generadas (correos simulados con --dry-run)
salidas/

# Datos de prueba generados
datos_prueba.xlsx

# Archivos de clientes: tienen datos personales (cedulas, salud). Nunca al repositorio.
*.xlsx
*.xls
*.csv
!tests/fixtures/*.xlsx

# Credenciales de Google (cuenta de servicio): solo en la variable GOOGLE_SERVICE_ACCOUNT_JSON
*service-account*.json
*service_account*.json
credenciales*.json
